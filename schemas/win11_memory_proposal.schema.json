{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "source_results",
    "new_notes",
    "claim_relations"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^win11-[0-9]{8}T[0-9]{6}-[0-9a-f]{8}$"
    },
    "source_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "disposition",
          "existing_target_memory_ids",
          "new_note_refs",
          "note"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "merged",
              "no_business_change",
              "tombstone_recorded"
            ]
          },
          "existing_target_memory_ids": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^BUSINESS-[0-9]{8}-[0-9]{3}$"
            }
          },
          "new_note_refs": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "pattern": "^N[0-9]{1,2}$"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "new_notes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "directory",
          "filename_slug",
          "category",
          "memory_kind",
          "origin_type",
          "status",
          "evidence_level",
          "sensitivity",
          "source_check",
          "fact_status",
          "source_ref",
          "supersedes",
          "memory_content",
          "evidence_boundary",
          "source_section",
          "update_log"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^N[0-9]{1,2}$"
          },
          "directory": {
            "type": "string",
            "enum": [
              "01_关键业务认知",
              "02_内部业务资料",
              "03_外部沟通"
            ]
          },
          "filename_slug": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[^/\\\\.:][^/\\\\:]*$"
          },
          "category": {
            "type": "string",
            "enum": [
              "business_cognition",
              "internal_material",
              "external_communication"
            ]
          },
          "memory_kind": {
            "type": "string",
            "enum": [
              "fact",
              "judgment",
              "decision",
              "status",
              "open_question",
              "guardrail",
              "source_index"
            ]
          },
          "origin_type": {
            "type": "string",
            "enum": [
              "internal_file",
              "internal_communication",
              "customer_communication",
              "system_observation",
              "local_observation",
              "mixed"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "review_required"
            ]
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "internal_source",
              "unverified",
              "user_reported",
              "external_verified"
            ]
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "confidential",
              "internal"
            ]
          },
          "source_check": {
            "type": "string",
            "enum": [
              "matched",
              "unverified",
              "discrepant"
            ]
          },
          "fact_status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "conflicting",
              "not_applicable"
            ]
          },
          "source_ref": {
            "type": "string",
            "maxLength": 300
          },
          "supersedes": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^BUSINESS-[0-9]{8}-[0-9]{3}$"
            }
          },
          "memory_content": {
            "type": "string",
            "maxLength": 4000
          },
          "evidence_boundary": {
            "type": "string",
            "maxLength": 2000
          },
          "source_section": {
            "type": "string",
            "maxLength": 1500
          },
          "update_log": {
            "type": "string",
            "maxLength": 800
          }
        }
      }
    },
    "claim_relations": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_handle", "relation", "source_tokens", "reason"],
        "properties": {
          "claim_handle": {"type": "string", "pattern": "^claim-[0-9a-f]{20}$"},
          "relation": {"type": "string", "enum": ["support", "refute", "supersede", "duplicate", "unrelated"]},
          "source_tokens": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f-]{27}$"}
          },
          "reason": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}
