<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Disabled</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/example</string>
		<key>PATH</key>
		<string>/Users/example/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.example.business-sync-supervisor-health</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/example/AI/LocalData/BUSINESS-Memory-Bridge.nosync/bin/business_sync_supervisor_health.py</string>
		<string>--config</string>
		<string>/Users/example/AI/LocalData/BUSINESS-Memory-Bridge.nosync/config.json</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/example/AI/LocalData/BUSINESS-Memory-Bridge.nosync/logs/sync-supervisor-health.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/example/AI/LocalData/BUSINESS-Memory-Bridge.nosync/logs/sync-supervisor-health.out.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>WorkingDirectory</key>
	<string>/Users/example/AI/LocalData/BUSINESS-Memory-Bridge.nosync</string>
